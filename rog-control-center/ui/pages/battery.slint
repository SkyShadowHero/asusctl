import { FluentTheme } from "../fluent/theme.slint";
import { SystemSlider, RogItem } from "../widgets/common.slint";
import { VerticalBox, ScrollView } from "std-widgets.slint";import { SystemPageData } from "system.slint";

export component PageBattery inherits Rectangle {
    clip: true;

    ScrollView {
        VerticalLayout {
            padding: FluentTheme.space-page;
            spacing: 8px;
            alignment: LayoutAlignment.start;

            Rectangle {
                background: FluentTheme.layer-card;
                border-color: FluentTheme.stroke-card;
                border-width: 1px;
                border-radius: FluentTheme.radius-card;
                height: 36px;
                Text {
                    font-size: 16px;
                    color: FluentTheme.text-primary;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    text: @tr("Battery Information");
                }
            }

            if SystemPageData.battery_health != -1: Rectangle {
                background: FluentTheme.layer-card;
                border-color: FluentTheme.stroke-card;
                border-width: 1px;
                border-radius: FluentTheme.radius-control;
                
                VerticalLayout {
                    padding: FluentTheme.space-card;
                    spacing: 8px;
                    
                    HorizontalLayout {
                        alignment: LayoutAlignment.space-between;
                        Text {
                            text: @tr("Battery Health (Capacity):");
                            color: FluentTheme.text-primary;
                        }
                        Text {
                            text: SystemPageData.battery_health + "%";
                            font-weight: 700;
                            color: SystemPageData.battery_health > 80 ? FluentTheme.status-success : (SystemPageData.battery_health > 50 ? FluentTheme.status-warning : FluentTheme.status-error);
                        }
                    }

                    HorizontalLayout {
                        alignment: LayoutAlignment.space-between;
                        Text {
                            text: @tr("Status:");
                            color: FluentTheme.text-primary;
                        }
                        Text {
                            text: SystemPageData.battery_status;
                            font-weight: 700;
                            color: FluentTheme.text-primary;
                        }
                    }

                    if SystemPageData.battery_power_consumption != -1.0: HorizontalLayout {
                        alignment: LayoutAlignment.space-between;
                        Text {
                            text: @tr("Power Draw:");
                            color: FluentTheme.text-primary;
                        }
                        Text {
                            text: Math.round(SystemPageData.battery_power_consumption * 10) / 10 + " W";
                            font-weight: 700;
                            color: SystemPageData.battery_status == "Discharging" ? FluentTheme.status-error : FluentTheme.status-success;
                        }
                    }

                    if SystemPageData.battery_time_estimate != "": HorizontalLayout {
                        alignment: LayoutAlignment.space-between;
                        Text {
                            text: SystemPageData.battery_status == "Charging" ? @tr("Time to Full:") : @tr("Time Remaining:");
                            color: FluentTheme.text-primary;
                        }
                        Text {
                            text: SystemPageData.battery_time_estimate;
                            font-weight: 700;
                            color: FluentTheme.text-primary;
                        }
                    }
                }
            }

            if SystemPageData.charge_control_end_threshold != -1: SystemSlider {
                text: @tr("Charge limit");
                minimum: 20;
                maximum: 100;
                has_reset: false;
                enabled <=> SystemPageData.charge_control_enabled;
                value: SystemPageData.charge_control_end_threshold;
                released => {
                    SystemPageData.charge_control_end_threshold = self.value;
                    SystemPageData.cb_charge_control_end_threshold(Math.round(SystemPageData.charge_control_end_threshold))
                }
            }
        }
    }
}
