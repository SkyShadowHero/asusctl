import { VerticalBox } from "std-widgets.slint";
import { FluentTheme } from "fluent/theme.slint";
import { FluentTextButton, FluentInfoBar, FluentCard } from "fluent/components.slint";
import { AppSize } from "globals.slint";
import { PageSystem, SystemPageData, AttrMinMax } from "pages/system.slint";
import { SideBar } from "widgets/sidebar.slint";
import { PageAbout } from "pages/about.slint";
import { PageFans } from "pages/fans.slint";
import { PageAnime, AnimePageData } from "pages/anime.slint";
import { PageSlash, SlashPageData } from "pages/slash.slint";
import { RogItem } from "widgets/common.slint";
import { PageAura } from "pages/aura.slint";
import { PageGPU, GPUPageData } from "pages/gpu.slint";
import { PageBattery } from "pages/battery.slint";
import { Node } from "widgets/graph.slint";
export { Node }
import { FanPageData, FanType, Profile } from "types/fan_types.slint";
export { FanPageData, FanType, Profile }
import { AuraPageData, AuraDevType, LaptopAuraPower, AuraPowerState, PowerZones, AuraEffect } from "types/aura_types.slint";
export { AuraPageData, AuraDevType, LaptopAuraPower, AuraPowerState, PowerZones, AuraEffect }
import { PageAppSettings, AppSettingsPageData, GlobalShortcutStatus } from "pages/app_settings.slint";

export { AppSize, AttrMinMax, SystemPageData, AnimePageData, SlashPageData, AppSettingsPageData, GlobalShortcutStatus, GPUPageData }
// Exported so a future in-app theme switch can override FluentTheme.dark.
// By default the theme follows the OS colour scheme.
export { FluentTheme }

export component MainWindow inherits Window {
    title: "ROG Control";
    always-on-top: true;
    // "Segoe UI Variable" is the WinUI font; on Linux we fall back to Noto Sans.
    default-font-family: "Noto Sans";
    default-font-size: FluentTheme.font-body;
    default-font-weight: FluentTheme.weight-body;
    icon: @image-url("../data/rog-control-center.png");
    in property <[bool]> sidebar_items_avilable: [
        true,
        true,
        true,
        true,
        true,
        true, // GPU Configuration
        true, // Battery Info
        true, // App Settings
        true, // About
    ];
    private property <bool> show_notif;
    // TODO: change if TUF on the logo in the menu on the main page
    in property <bool> is_tuf: false;
    private property <bool> fade_cover;
    private property <bool> toast: false;
    private property <string> toast_text: @tr("I show when something is waiting");
    callback show_toast(string);
    show_toast(text) => {
        toast = text != "";
        toast_text = text;
    }
    callback clear_toast_if_matches(string);
    clear_toast_if_matches(text) => {
        if (toast && toast_text == text) {
            toast = false;
            toast_text = "";
        }
    }
    callback exit-app();
    callback show_notification(bool);
    show_notification(yes) => {
        show_notif = yes;
        fade_cover = yes;
    }
    callback external_colour_change();
    external_colour_change() => {
        aura.external_colour_change();
        aura.external_colour_change();
    }
    min-height: AppSize.height;
    min-width: AppSize.width;
    background: FluentTheme.layer-window-mica;

    HorizontalLayout {
        padding: 0px;
        VerticalLayout {
            padding: 0px;
            side-bar := SideBar {
                model: [
                    @tr("Menu1" => "System Control"),
                    @tr("Menu2" => "Keyboard Aura"),
                    @tr("Menu3" => "AniMe Matrix"),
                    @tr("Menu4" => "Slash Lighting"),
                    @tr("Menu5" => "Fan Curves"),
                    @tr("Menu6" => "GPU Configuration"),
                    @tr("Menu9" => "Battery Info"),
                    @tr("Menu7" => "App Settings"),
                    @tr("Menu8" => "About"),
                ];
                available: root.sidebar_items_avilable;
                is_tuf: root.is_tuf;
            }

            FluentTextButton {
                width: side-bar.width - 2 * FluentTheme.space-item;
                label: @tr("Quit App");
                clicked => {
                    root.exit-app();
                }
            }
        }

        Rectangle {
            // Transparent so the window's Mica sheen shows through the pages.
            background: transparent;
            if(side-bar.current-item == 0): page := PageSystem {
                width: root.width - side-bar.width;
                height: root.height;
            }

            /*if(side-bar.current-item == 1):*/ aura := PageAura {
                width: root.width - side-bar.width;
                height: root.height;
                visible: side-bar.current-item == 1;
            }

            if(side-bar.current-item == 2): PageAnime {
                width: root.width - side-bar.width;
                height: root.height;
                visible: side-bar.current-item == 2;
            }

            if(side-bar.current-item == 3): PageSlash {
                width: root.width - side-bar.width;
                height: root.height;
                visible: side-bar.current-item == 3;
            }

            if(side-bar.current-item == 4): fans := PageFans {
                width: root.width - side-bar.width;
                height: root.height;
                visible: side-bar.current-item == 4;
            }

            if(side-bar.current-item == 5): PageGPU {
                width: root.width - side-bar.width;
                height: root.height;
                visible: side-bar.current-item == 5;
            }

            if(side-bar.current-item == 6): PageBattery {
                width: root.width - side-bar.width;
                height: root.height;
                visible: side-bar.current-item == 6;
            }

            if(side-bar.current-item == 7): PageAppSettings {
                width: root.width - side-bar.width;
                height: root.height;
                visible: side-bar.current-item == 7;
            }

            if(side-bar.current-item == 8): PageAbout {
                width: root.width - side-bar.width;
                height: root.height;
                visible: side-bar.current-item == 8;
            }

            // WinUI InfoBar instead of the old full-bleed accent strip.
            if toast: FluentInfoBar {
                x: FluentTheme.space-page;
                y: root.height - self.height - FluentTheme.space-page;
                width: root.width - side-bar.width - 2 * FluentTheme.space-page;
                message: root.toast_text;
                dismissed => {
                    toast = false;
                }
            }
        }
    }

    if fade_cover: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000080;
        opacity: 0.7;
        TouchArea {
            height: 100%;
            width: 100%;
            clicked => {
                // toolbar-dropdown.close();
                if (show_notif) {
                    show_notif = false;
                }
                fade_cover = false;
            }
        }
    }


    // // TODO: or use Dialogue
    if show_notif: Rectangle {
        x: root.width / 8;
        y: root.height / 8;
        height: (root.height / 8) * 6;
        width: (root.width / 8) * 6;
        TouchArea {
            height: 100%;
            width: 100%;
            clicked => {
                show_notif = false;
                exit-app();
            }
        }

        // TODO: add properties to display
        Rectangle {
            height: 100%;
            width: 100%;
            background: FluentTheme.layer-flyout;
            border-radius: FluentTheme.radius-card;
            border-width: 1px;
            border-color: FluentTheme.stroke-card;
            Text {
                text: @tr("Click here to exit");
                color: FluentTheme.text-primary;
                font-size: FluentTheme.font-body;
            }
        }
    }

    if SomeError.error_message != "": Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: FluentTheme.layer-window-mica;
        border-color: FluentTheme.stroke-card;
        border-width: 1px;
        border-radius: FluentTheme.radius-overlay;

        VerticalBox {
            RogItem {
                min-height: 50px;
                max-height: 100px;
                Text {
                    text <=> SomeError.error_message;
                    color: FluentTheme.text-primary;
                    font-size: FluentTheme.font-section;
                    font-weight: FluentTheme.weight-strong;
                }
            }

            Text {
                text <=> SomeError.error_help;
                color: FluentTheme.text-secondary;
                font-size: FluentTheme.font-body;
                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment: TextVerticalAlignment.center;
            }
        }
    }
}

export global SomeError {
    in property <string> error_message: "";
    in property <string> error_help: "";
}
