// Reusable WinUI 3 building blocks. These sit on top of Slint's built-in
// fluent std-widgets and are meant for the custom Rectangle-based parts of
// the UI (sidebar, setting rows, flyouts, info bars).
//
// Design rule: state is expressed as a translucent overlay layer, never by
// tinting the base colour. That keeps hover/pressed/disabled independent of
// the surface underneath, which is how WinUI's VisualStateManager behaves.

import { FluentTheme } from "theme.slint";

// A WinUI Settings-style card. Use as the container for one or more rows.
export component FluentCard inherits Rectangle {
    in property <bool> elevated: false;
    in property <length> card-radius: FluentTheme.radius-card;

    background: FluentTheme.layer-card;
    border-radius: root.card-radius;
    border-width: 1px;
    border-color: FluentTheme.stroke-card;

    drop-shadow-blur: root.elevated ? FluentTheme.shadow-blur : 0px;
    drop-shadow-color: FluentTheme.shadow-card;
    drop-shadow-offset-y: root.elevated ? FluentTheme.shadow-offset-y : 0px;

    @children
}

// Translucent interaction overlay. Place it as the last child of an item so
// it sits above the content, and bind `clicked` for the action.
export component FluentStateLayer inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <length> layer-radius: FluentTheme.radius-control;

    callback clicked <=> touch.clicked;
    out property <bool> hovered: touch.has-hover;
    out property <bool> pressed: touch.pressed;

    border-radius: root.layer-radius;
    background: !root.enabled ? FluentTheme.state-disabled
        : root.selected ? FluentTheme.state-selected
        : touch.pressed ? FluentTheme.state-pressed
        : touch.has-hover ? FluentTheme.state-hover
        : transparent;

    // Literal duration: Slint requires a constant here, kept in sync with
    // FluentTheme.duration-normal (150ms, same as the built-in fluent Button).
    animate background { duration: 150ms; }

    touch := TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
    }
}

// Section heading used above a group of cards.
export component FluentSectionHeader inherits Text {
    color: FluentTheme.text-primary;
    font-size: FluentTheme.font-section;
    font-weight: FluentTheme.weight-strong;
    vertical-alignment: TextVerticalAlignment.center;
}

// Secondary / explanatory text under a setting.
export component FluentCaption inherits Text {
    color: FluentTheme.text-secondary;
    font-size: FluentTheme.font-caption;
    font-weight: FluentTheme.weight-body;
    wrap: TextWrap.word-wrap;
    vertical-alignment: TextVerticalAlignment.center;
}

// The 3px accent pill on the left edge of the selected NavigationView item.
//
// There is exactly ONE of these per sidebar, owned by SideBar itself. The
// parent binds `pill-center` to the selected row's centre, so a selection
// change slides the same pill to its new position (WinUI NavigationView
// behaviour) instead of fading one pill out and fading another one in.
//
// Motion model -- Compose-style shared-element STRETCH (the same effect the
// Plasma launcher sidebar pill uses):
//   * The pill is described by TWO independent edges, `front-y` (the edge
//     LEADING the motion) and `back-y` (the TRAILING edge).
//   * The leading edge reaches the destination first and at normal speed.
//   * The trailing edge follows more slowly, so it visibly chases the front.
//   Because the trailing edge lags behind the leading one, the pill looks
//   LONGER while travelling -- it morphs from row to row rather than sliding
//   as a rigid bar or collapsing to a dot. When settled the two edges are the
//   normal ends of the pill, so there is never a "vanish and reappear" feel.
export component FluentNavIndicator inherits Rectangle {
    in property <length> pill-height: FluentTheme.size-indicator-height;
    in property <length> pill-center: 0px;
    in property <bool> ready: true;
    in property <bool> active: true;

    // Full-height transparent overlay anchored to the sidebar's top edge, so
    // the pill child can sit at any absolute y inside it.
    width: FluentTheme.size-indicator-width;
    height: 100%;
    background: transparent;

    // Fade in only once positioned (SideBar's indicator-ready guard), so a
    // stale / off-screen position is never seen.
    opacity: root.active ? 1 : 0;
    animate opacity { duration: 150ms; }

    in-out property <length> front-y: root.pill-center - root.pill-height / 2;
    in-out property <length> back-y: root.pill-center + root.pill-height / 2;
    in-out property <length> last-center: root.pill-center;

    changed pill-center => {
        if (!root.ready) {
            // First placement while the layout is still settling: snap both
            // edges into place with no stretch.
            root.front-y = root.pill-center - root.pill-height / 2;
            root.back-y = root.pill-center + root.pill-height / 2;
        } else if (root.pill-center > root.last-center) {
            // Travelling DOWN: the bottom edge leads, the top edge trails.
            root.front-y = root.pill-center + root.pill-height / 2;
            root.back-y = root.pill-center - root.pill-height / 2;
        } else if (root.pill-center < root.last-center) {
            // Travelling UP: the top edge leads, the bottom edge trails.
            root.front-y = root.pill-center - root.pill-height / 2;
            root.back-y = root.pill-center + root.pill-height / 2;
        } else {
            root.front-y = root.pill-center - root.pill-height / 2;
            root.back-y = root.pill-center + root.pill-height / 2;
        }
        root.last-center = root.pill-center;
    }

    // WinUI PointToPointEasing = cubic-bezier(0.55, 0.55, 0, 1) for the lead
    // edge; the trailing edge eases in a little slower so it visibly catches
    // up -- that lag is what reads as "the back is chasing the front".
    animate front-y { duration: 250ms; easing: cubic-bezier(0.55, 0.55, 0, 1); }
    animate back-y { duration: 360ms; easing: ease-in-out; }

    // Draw between the two edges; order-independent so direction flips never
    // matter.
    Rectangle {
        x: 0px;
        y: Math.min(root.front-y, root.back-y);
        width: FluentTheme.size-indicator-width;
        height: Math.max(root.front-y, root.back-y) - Math.min(root.front-y, root.back-y);
        border-radius: FluentTheme.size-indicator-width / 2;
        background: FluentTheme.accent-default;
    }
}

// WinUI InfoBar. Replaces the old full-width solid-colour toast.
export component FluentInfoBar inherits Rectangle {
    in property <string> message;
    in property <brush> severity: FluentTheme.status-info;

    callback dismissed();

    height: FluentTheme.size-item-height;
    background: FluentTheme.layer-flyout;
    border-radius: FluentTheme.radius-control;
    border-width: 1px;
    border-color: FluentTheme.stroke-card;
    drop-shadow-blur: FluentTheme.shadow-blur;
    drop-shadow-color: FluentTheme.shadow-card;
    drop-shadow-offset-y: FluentTheme.shadow-offset-y;
    clip: true;

    HorizontalLayout {
        padding: 0px;
        spacing: FluentTheme.space-card;

        // WinUI InfoBar colour bar on the leading edge.
        Rectangle {
            width: 4px;
            height: 100%;
            background: root.severity;
        }

        Text {
            text: root.message;
            color: FluentTheme.text-primary;
            font-size: FluentTheme.font-body;
            font-weight: FluentTheme.weight-body;
            vertical-alignment: TextVerticalAlignment.center;
            horizontal-alignment: TextHorizontalAlignment.left;
        }
    }

    // The whole bar is dismissible, matching the previous toast behaviour.
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismissed(); }
    }
}

// A flat navigation/action button (used for the sidebar "Quit App" action).
export component FluentTextButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <length> button-radius: FluentTheme.radius-control;
    callback clicked;

    height: FluentTheme.size-control-height + 4px;
    border-radius: root.button-radius;

    Text {
        x: FluentTheme.space-card;
        width: parent.width - 2 * FluentTheme.space-card;
        height: 100%;
        text: root.label;
        color: root.enabled ? FluentTheme.text-primary : FluentTheme.text-disabled;
        font-size: FluentTheme.font-body;
        font-weight: FluentTheme.weight-body;
        vertical-alignment: TextVerticalAlignment.center;
    }

    FluentStateLayer {
        enabled: root.enabled;
        layer-radius: root.button-radius;
        clicked => { root.clicked(); }
    }
}
